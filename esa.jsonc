// 阿里云 ESA 构建配置（jsonc 支持注释）
//
// 已验证生效的字段：
//   installCommand  — 留空跳过依赖安装（日志 "installCommand is empty, skipping installation"）
//   buildCommand    — 构建命令（日志 "Using buildCommand in esa.jsonc"）
//
// assets 目录字段名暂无官方文档，这里同时写入多种常见命名（值均为 dist）：
//   ESA 识别其中任意一个即完成静态资源目录配置；未识别的字段会被忽略，无副作用。
//   若 ESA 控制台里有「assets 目录 / 静态资源目录」设置项，也可直接填 dist（以控制台为准）。
{
  "installCommand": "",
  "buildCommand": "npm run build",

  "assets": "dist",
  "assetsDirectory": "dist",
  "assetsDir": "dist",
  "outputDirectory": "dist",
  "output": "dist"
}
